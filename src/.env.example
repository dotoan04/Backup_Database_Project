# =============================================================================
# MBC Database Backup - configuration template
# Spec: MBC-SPEC-BACKUP-001 v0.2, section 5.1
#
# Deploy as /opt/mbc-backup/.env  --  chmod 600, chown root:root
# NEVER commit the filled-in version to git.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# No database passwords here on purpose. backup.sh reads POSTGRES_PASSWORD
# straight out of each container's environment via `docker inspect` (see 5.1.1),
# so there is no second copy of 9 secrets to keep in sync.

# --- Azure AD App Registration (see docs/azure-ad-setup.md) ------------------
AZ_TENANT_ID=
AZ_CLIENT_ID=

# Authenticate with EITHER a client secret OR a certificate.
# Certificate is recommended: secrets expire silently and kill the backup.
# AZ_CERT_PATH must be a single PEM file holding the private key AND the
# certificate. Keep it chmod 600, root:root, outside of git.
AZ_CLIENT_SECRET=
AZ_CERT_PATH=

# Graph site-id of the SharePoint site, format: host,siteCollectionId,webId
SP_SITE_ID=
# Leave empty to use the site's default Documents library. Set this to the
# display name of a different document library, e.g. Backup_Database_Devs.
SP_LIBRARY_NAME=
# Folder path inside the selected document library.
SP_LIBRARY_PATH=DB_Backups

# --- Power Automate ----------------------------------------------------------
# SECURITY: this URL carries a `sig=` query parameter and IS a secret.
# Anyone holding it can invoke the flow. Never commit, never paste in a ticket.
FLOW_WEBHOOK_URL=

# --- Operational parameters --------------------------------------------------
LOCAL_RETENTION_DAYS=7
REMOTE_RETENTION_DAYS=30

# A dump smaller than this is treated as corrupt/empty and is never uploaded.
MIN_DUMP_SIZE_BYTES=10240

# Skip the dump when free disk falls below this. A full filesystem stops
# PostgreSQL from writing WAL, i.e. the backup would take production down.
MIN_FREE_DISK_MB=5120

# --- Encryption (spec 3.4 / 6.3) ---------------------------------------------
# Set to true once section 3.4 is answered and any database is confirmed to
# hold PII. Requires `age` installed and AGE_RECIPIENT set.
# The matching private key MUST be stored somewhere other than the backup
# (password manager / Azure Key Vault) or encryption is pointless.
ENCRYPT_ENABLED=false
AGE_RECIPIENT=

# --- Upload verification -----------------------------------------------------
# download = re-download the uploaded file and compare sha256 (strongest,
#            costs ~40 MB/day of extra traffic at current data volume)
# size     = compare the byte count reported by Graph only
REMOTE_VERIFY=download

# --- SharePoint rotation safety ----------------------------------------------
# Never drop below this many backup sets per site, whatever the retention says.
REMOTE_MIN_KEEP_SETS=3
