# These files are deployed to a Linux host and executed there. A CRLF line
# ending turns the shebang into `#!/usr/bin/env bash\r`, which fails with a
# confusing "bad interpreter" error. Force LF regardless of the developer's
# core.autocrlf setting.
*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.example       text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
logrotate/*     text eol=lf
*.md            text eol=lf
*.json          text eol=lf

*.pdf           binary
